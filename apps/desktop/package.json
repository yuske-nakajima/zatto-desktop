{
  "name": "zatto-desktop",
  "productName": "zatto",
  "version": "0.1.9",
  "description": "Desktop shell for zatto",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "start": "node scripts/run-forge.mjs start",
    "smoke:dev": "node scripts/run-forge.mjs start -- --smoke-test-zatto-server",
    "smoke:packaged": "node scripts/verify-packaged-contents.mjs && node scripts/run-packaged-smoke.mjs",
    "package": "node scripts/run-forge.mjs package",
    "make": "node scripts/run-forge.mjs make && node scripts/verify-packaged-contents.mjs",
    "check": "pnpm run typecheck && biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@yuske-nakajima/zatto": "3.8.2",
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/asar": "4.3.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.6.6",
    "css-loader": "7.1.5",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "esbuild-loader": "4.5.0",
    "style-loader": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  }
}
