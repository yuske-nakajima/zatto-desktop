{
  "name": "zatto-desktop-workspace",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "icons:generate": "pnpm --filter zatto-desktop icons:generate",
    "start": "pnpm --filter zatto-desktop start",
    "smoke:dev": "pnpm --filter zatto-desktop smoke:dev",
    "smoke:packaged": "pnpm --filter zatto-desktop smoke:packaged",
    "package": "pnpm --filter zatto-desktop package",
    "make": "pnpm --filter zatto-desktop make",
    "site:dev": "pnpm --filter zatto-site dev",
    "site:build": "pnpm --filter zatto-site build",
    "site:check": "pnpm --filter zatto-site check",
    "check": "pnpm run typecheck && biome check .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "format": "biome check --write .",
    "test": "pnpm --recursive --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5"
  }
}
