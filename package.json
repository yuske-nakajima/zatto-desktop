{
  "name": "zatto-desktop",
  "productName": "Zatto Desktop",
  "version": "0.1.0",
  "description": "macOS desktop shell for zatto",
  "main": ".webpack/main",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.13",
    "css-loader": "7.1.2",
    "electron": "43.3.0",
    "eslint": "9.39.2",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1"
  }
}
